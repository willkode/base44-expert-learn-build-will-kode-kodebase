{
  "name": "Process Scheduled Social Posts",
  "description": "Every 5 minutes, finds queued ScheduledPost records whose scheduled_at is due and publishes them to the correct platform, handling retries and failures.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-06-17T16:08:18.092000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "process_scheduled_social_posts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processScheduledSocialPosts",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}