{
  "name": "SecurityFinding",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "blueprintId": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "area": {
      "type": "string"
    },
    "issue": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "fixedStatus": {
      "type": "string",
      "enum": [
        "open",
        "reviewed",
        "resolved"
      ],
      "default": "open"
    }
  },
  "required": [
    "projectId"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}