{
  "name": "Blueprint",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "executiveSummary": {
      "type": "string"
    },
    "appArchitecture": {
      "type": "string"
    },
    "entityPlan": {
      "type": "string"
    },
    "rolePermissionPlan": {
      "type": "string"
    },
    "pagePlan": {
      "type": "string"
    },
    "workflowPlan": {
      "type": "string"
    },
    "backendFunctionPlan": {
      "type": "string"
    },
    "integrationPlan": {
      "type": "string"
    },
    "securityPlan": {
      "type": "string"
    },
    "qaPlan": {
      "type": "string"
    },
    "mvpRoadmap": {
      "type": "string"
    },
    "versionPlan": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete"
      ],
      "default": "pending"
    }
  },
  "required": [
    "projectId"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$and": [
        {
          "created_by_id": {
            "$ne": "anonymous"
          }
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}