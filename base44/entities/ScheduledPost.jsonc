{
  "name": "ScheduledPost",
  "type": "object",
  "properties": {
    "social_post_id": {
      "type": "string",
      "description": "Linked SocialPost id (indexed lookup key)"
    },
    "campaign_id": {
      "type": "string"
    },
    "social_account_id": {
      "type": "string",
      "description": "Linked SocialAccount id used to publish"
    },
    "platform": {
      "type": "string",
      "enum": [
        "twitter",
        "reddit",
        "linkedin",
        "facebook",
        "instagram"
      ]
    },
    "platform_specific_payload": {
      "type": "object",
      "description": "Resolved per-platform publish payload",
      "properties": {
        "facebook_page_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "link_url": {
          "type": "string"
        },
        "media_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "post_type": {
          "type": "string",
          "enum": [
            "text",
            "link",
            "photo",
            "video",
            "reel"
          ]
        },
        "published": {
          "type": "boolean"
        },
        "call_to_action": {
          "type": "string"
        },
        "privacy_status": {
          "type": "string"
        },
        "instagram_business_account_id": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "reel",
            "carousel",
            "story"
          ]
        },
        "container_id": {
          "type": "string"
        },
        "children_container_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alt_text": {
          "type": "string"
        },
        "first_comment": {
          "type": "string"
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "share_to_feed": {
          "type": "boolean"
        },
        "location_id": {
          "type": "string"
        },
        "user_tags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "product_tags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "subreddit": {
          "type": "string",
          "description": "Target subreddit name (without the r/ prefix)"
        },
        "reddit_post_kind": {
          "type": "string",
          "enum": [
            "self",
            "link",
            "image"
          ],
          "description": "Reddit submission kind: self (text), link, or image"
        },
        "title": {
          "type": "string",
          "description": "Reddit post title"
        },
        "body": {
          "type": "string",
          "description": "Reddit self-post body (markdown)"
        },
        "flair_id": {
          "type": "string",
          "description": "Reddit flair template id"
        },
        "flair_text": {
          "type": "string",
          "description": "Reddit flair display text"
        },
        "nsfw": {
          "type": "boolean",
          "description": "Mark the Reddit submission as NSFW"
        },
        "spoiler": {
          "type": "boolean",
          "description": "Mark the Reddit submission as a spoiler"
        },
        "send_replies": {
          "type": "boolean",
          "description": "Send reply notifications to the author's inbox"
        },
        "suggested_comment": {
          "type": "string",
          "description": "Suggested first comment to add context after posting"
        },
        "promotion_disclosure": {
          "type": "string",
          "description": "Disclosure note appended when content is promotional"
        },
        "subreddit_rules_notes": {
          "type": "string",
          "description": "Reviewer notes about the target subreddit's rules"
        },
        "text": {
          "type": "string",
          "description": "X/Twitter primary post text (first tweet)"
        },
        "thread": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "X/Twitter thread: ordered list of follow-up tweet texts published as replies"
        },
        "media_url": {
          "type": "string",
          "description": "X/Twitter media URL to attach to the first tweet"
        },
        "media_id": {
          "type": "string",
          "description": "X/Twitter media id returned after uploading media to X"
        },
        "reply_settings": {
          "type": "string",
          "enum": [
            "everyone",
            "mentionedUsers",
            "following"
          ],
          "description": "X/Twitter reply permissions for the post"
        },
        "quote_post_id": {
          "type": "string",
          "description": "X/Twitter tweet id this post quotes"
        },
        "poll_options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "X/Twitter poll choices (optional, if poll support is enabled later)"
        },
        "poll_duration_minutes": {
          "type": "number",
          "description": "X/Twitter poll duration in minutes (optional)"
        }
      },
      "additionalProperties": true,
      "default": {}
    },
    "scheduled_at": {
      "type": "string",
      "description": "ISO timestamp when this job should publish (indexed lookup key)"
    },
    "timezone": {
      "type": "string",
      "default": "America/Chicago"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "processing",
        "published",
        "failed",
        "canceled",
        "skipped"
      ],
      "default": "queued"
    },
    "attempt_count": {
      "type": "number",
      "default": 0
    },
    "max_attempts": {
      "type": "number",
      "default": 3
    },
    "last_attempt_at": {
      "type": "string"
    },
    "next_retry_at": {
      "type": "string"
    },
    "platform_post_id": {
      "type": "string"
    },
    "platform_post_url": {
      "type": "string"
    },
    "thread_post_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "X/Twitter: all tweet ids created for a thread, in order"
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "platform"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}