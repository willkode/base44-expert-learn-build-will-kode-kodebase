{
  "name": "VaultPrompt",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short descriptive title for the prompt"
    },
    "prompt_body": {
      "type": "string",
      "description": "The full prompt text"
    },
    "category": {
      "type": "string",
      "description": "Primary category (e.g. Development, Business, SEO, Marketing, AI, Productivity)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Searchable tags"
    },
    "description": {
      "type": "string",
      "description": "Short explanation of what the prompt does"
    },
    "recommended_model": {
      "type": "string",
      "description": "Recommended AI model to use with this prompt (e.g. GPT-4o, Claude 3.5 Sonnet)"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "published": {
      "type": "boolean",
      "default": true,
      "description": "Whether this prompt is visible to users with access"
    }
  },
  "required": [
    "title",
    "prompt_body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}