{
  "name": "LibraryPrompt",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title of the prompt"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly unique slug for the prompt post page"
    },
    "category": {
      "type": "string",
      "enum": [
        "App Building",
        "Workflow",
        "Marketing",
        "Architecture",
        "Database",
        "Security",
        "UI Design",
        "Backend",
        "QA & Testing",
        "Optimization",
        "Debugging",
        "SEO & Marketing",
        "General"
      ],
      "default": "General",
      "description": "Category of the prompt"
    },
    "description": {
      "type": "string",
      "description": "Short description of what the prompt does"
    },
    "guide": {
      "type": "string",
      "description": "The prompt guide / how-to context in markdown, shown on the post page"
    },
    "promptText": {
      "type": "string",
      "description": "The full prompt text to copy"
    },
    "imageUrl": {
      "type": "string",
      "description": "AI-generated featured image URL"
    },
    "videoUrl": {
      "type": "string",
      "description": "Optional featured video (YouTube link or uploaded file URL); replaces the image on cards and the post page"
    },
    "seoTitle": {
      "type": "string",
      "description": "Optimized SEO/og title"
    },
    "seoDescription": {
      "type": "string",
      "description": "Optimized SEO/og meta description"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional tags"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this prompt is featured"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Sort order"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Published date shown in admin; falls back to created_date when empty"
    },
    "viewCount": {
      "type": "number",
      "default": 0,
      "description": "Post page views (incremented by trackPromptEvent)"
    },
    "copyCount": {
      "type": "number",
      "default": 0,
      "description": "Times the prompt was copied (incremented by trackPromptEvent)"
    }
  },
  "required": [
    "title",
    "promptText"
  ],
  "rls": {
    "read": {},
    "write": {
      "$and": [
        {
          "created_by_id": {
            "$ne": "anonymous"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}