{
  "name": "BlogContentPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "enum": [
        "traffic",
        "leads",
        "authority",
        "product_education",
        "launch",
        "support",
        "seo_cluster"
      ],
      "default": "traffic"
    },
    "targetAudience": {
      "type": "string"
    },
    "topicClusterId": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "contentMix": {
      "type": "object",
      "additionalProperties": true,
      "description": "Map of post_type -> count/ratio"
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "endDate": {
      "type": "string",
      "format": "date"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "twice_weekly",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "weekly",
      "description": "Publishing frequency used to space out suggested publish dates"
    },
    "defaultCategoryId": {
      "type": "string",
      "description": "Default BlogCategory id applied to generated posts"
    },
    "defaultTagIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "desiredTone": {
      "type": "string"
    },
    "articleLength": {
      "type": "string",
      "enum": [
        "short",
        "medium",
        "long",
        "comprehensive"
      ],
      "default": "long"
    },
    "requireApproval": {
      "type": "boolean",
      "default": true
    },
    "generateImages": {
      "type": "boolean",
      "default": true
    },
    "customInstructions": {
      "type": "string"
    },
    "strategySummary": {
      "type": "string",
      "description": "AI-generated summary of the content strategy"
    },
    "plannedPosts": {
      "type": "array",
      "description": "AI-generated post ideas with assigned keywords, intent, type, and scheduled dates",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "angle": {
            "type": "string"
          },
          "targetKeyword": {
            "type": "string"
          },
          "secondaryKeywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "searchIntent": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "suggestedCategory": {
            "type": "string"
          },
          "suggestedTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "string"
          },
          "scheduledDate": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdPostId": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}