{
  "name": "QuoteLineItem",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string"
    },
    "pricing_rule_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit_price": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "calculation_source": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_optional": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "quote_id",
    "title",
    "amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}