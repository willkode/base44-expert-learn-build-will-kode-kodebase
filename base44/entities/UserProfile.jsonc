{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "ID of the linked user"
    },
    "fullName": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "companyName": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "agency"
      ],
      "default": "free"
    },
    "blueprintLimit": {
      "type": "number",
      "default": 1
    },
    "blueprintsUsed": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "userId"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}