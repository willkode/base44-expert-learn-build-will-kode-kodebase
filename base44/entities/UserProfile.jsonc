{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Linked user id"
    },
    "fullName": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "companyName": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "agency"
      ],
      "default": "free"
    },
    "blueprintLimit": {
      "type": "number",
      "default": 3
    },
    "blueprintsUsed": {
      "type": "number",
      "default": 0
    },
    "usagePeriodStart": {
      "type": "string",
      "description": "ISO timestamp of the start of the current usage period"
    },
    "callCreditsUsed": {
      "type": "number",
      "default": 0,
      "description": "Number of free monthly 1hr call credits used in the current credit period"
    },
    "callCreditPeriodStart": {
      "type": "string",
      "description": "ISO timestamp of the start of the current monthly call-credit period"
    }
  },
  "required": [
    "userId"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$and": [
        {
          "created_by_id": {
            "$ne": "anonymous"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}