{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "read",
        "replied",
        "archived"
      ],
      "default": "new"
    },
    "quoteAmountCents": {
      "type": "number",
      "description": "Amount quoted to this lead, in cents"
    },
    "quoteMessage": {
      "type": "string",
      "description": "Custom message included with the payment link email"
    },
    "quotePaymentLinkUrl": {
      "type": "string",
      "description": "Square hosted payment link sent to the lead"
    },
    "quoteSentAt": {
      "type": "string",
      "description": "ISO timestamp the payment link was emailed"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "$and": [
        {
          "created_by_id": {
            "$ne": "anonymous"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}