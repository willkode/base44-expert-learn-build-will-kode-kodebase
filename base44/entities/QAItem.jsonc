{
  "name": "QAItem",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "blueprintId": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "testName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "expectedResult": {
      "type": "string"
    },
    "auditPrompt": {
      "type": "string",
      "description": "Ready-to-use Base44 prompt the user can paste to audit/verify this QA task"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "projectId"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$and": [
        {
          "created_by_id": {
            "$ne": "anonymous"
          }
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}