{
  "name": "VideoScene",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "scene_number": {
      "type": "number",
      "default": 1
    },
    "title": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "narration": {
      "type": "string"
    },
    "visual_prompt": {
      "type": "string"
    },
    "negative_prompt": {
      "type": "string"
    },
    "duration_target": {
      "type": "number",
      "default": 6
    },
    "audio_duration": {
      "type": "number",
      "default": 0
    },
    "video_duration": {
      "type": "number",
      "default": 0
    },
    "transition_out": {
      "type": "string",
      "default": "cut"
    },
    "camera_direction": {
      "type": "string"
    },
    "motion_direction": {
      "type": "string"
    },
    "starting_state": {
      "type": "string"
    },
    "ending_state": {
      "type": "string"
    },
    "continuity_notes": {
      "type": "string"
    },
    "caption_text": {
      "type": "string"
    },
    "storyboard_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "revisions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "revision_number": {
            "type": "number"
          },
          "video_url": {
            "type": "string"
          },
          "audio_url": {
            "type": "string"
          },
          "storyboard_url": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SCRIPT_READY",
        "STORYBOARD_READY",
        "AUDIO_QUEUED",
        "AUDIO_PROCESSING",
        "AUDIO_READY",
        "VIDEO_QUEUED",
        "VIDEO_PROCESSING",
        "VIDEO_READY",
        "APPROVED",
        "FAILED"
      ],
      "default": "SCRIPT_READY"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved"
      ],
      "default": "pending"
    },
    "revision_number": {
      "type": "number",
      "default": 0
    },
    "is_locked": {
      "type": "boolean",
      "default": false
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "narration"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$and": [
        {
          "created_by_id": {
            "$ne": "anonymous"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}