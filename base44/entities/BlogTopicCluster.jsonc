{
  "name": "BlogTopicCluster",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pillarKeyword": {
      "type": "string"
    },
    "relatedKeywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "pillarPostId": {
      "type": "string",
      "description": "Linked pillar BlogPost id"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "completed",
        "archived"
      ],
      "default": "planned"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}