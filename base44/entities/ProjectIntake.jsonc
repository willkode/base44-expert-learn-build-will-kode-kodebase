{
  "name": "ProjectIntake",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "appName": {
      "type": "string"
    },
    "appDescription": {
      "type": "string"
    },
    "targetAudience": {
      "type": "string"
    },
    "userRoles": {
      "type": "string"
    },
    "mainFeatures": {
      "type": "string"
    },
    "adminNeeds": {
      "type": "string"
    },
    "integrationsNeeded": {
      "type": "string"
    },
    "paymentNeeds": {
      "type": "string"
    },
    "aiFeaturesNeeded": {
      "type": "string"
    },
    "securityLevel": {
      "type": "string",
      "enum": [
        "basic",
        "standard",
        "high"
      ],
      "default": "standard"
    },
    "launchGoal": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "projectId"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}