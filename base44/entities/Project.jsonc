{
  "name": "Project",
  "type": "object",
  "properties": {
    "ownerId": {
      "type": "string",
      "description": "Owner user id"
    },
    "projectName": {
      "type": "string"
    },
    "appType": {
      "type": "string"
    },
    "shortDescription": {
      "type": "string"
    },
    "appUrl": {
      "type": "string",
      "description": "The public URL where the app is or will be hosted"
    },
    "targetUsers": {
      "type": "string"
    },
    "monetizationModel": {
      "type": "string"
    },
    "platformFocus": {
      "type": "string",
      "default": "Base44"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generating",
        "completed",
        "archived"
      ],
      "default": "draft"
    },
    "currentStep": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "projectName"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$and": [
        {
          "created_by_id": {
            "$ne": "anonymous"
          }
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}