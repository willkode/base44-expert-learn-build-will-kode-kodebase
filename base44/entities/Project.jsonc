{
  "name": "Project",
  "type": "object",
  "properties": {
    "ownerId": {
      "type": "string",
      "description": "ID of the owning user"
    },
    "projectName": {
      "type": "string"
    },
    "appType": {
      "type": "string"
    },
    "shortDescription": {
      "type": "string"
    },
    "targetUsers": {
      "type": "string"
    },
    "monetizationModel": {
      "type": "string"
    },
    "platformFocus": {
      "type": "string",
      "default": "Base44"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generating",
        "completed",
        "archived"
      ],
      "default": "draft"
    },
    "currentStep": {
      "type": "string"
    }
  },
  "required": [
    "projectName"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}