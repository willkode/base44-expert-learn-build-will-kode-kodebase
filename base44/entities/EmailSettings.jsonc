{
  "name": "EmailSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique settings key, use 'global'"
    },
    "resendApiKeyConfigured": {
      "type": "boolean",
      "default": false,
      "description": "Whether RESEND_API_KEY secret is set (status only \u2014 never the key itself)"
    },
    "resendFromEmail": {
      "type": "string"
    },
    "resendFromName": {
      "type": "string"
    },
    "resendReplyToEmail": {
      "type": "string"
    },
    "resendDomain": {
      "type": "string"
    },
    "resendAudienceId": {
      "type": "string"
    },
    "resendSegmentId": {
      "type": "string",
      "description": "Resend Segment id to assign newsletter subscribers to (replaces deprecated Audiences)"
    },
    "webhookConfigured": {
      "type": "boolean",
      "default": false
    },
    "lastSuccessfulSendAt": {
      "type": "string"
    },
    "lastWebhookReceivedAt": {
      "type": "string"
    },
    "lastError": {
      "type": "string"
    },
    "domainVerified": {
      "type": "boolean",
      "default": false
    },
    "spfConfigured": {
      "type": "boolean",
      "default": false
    },
    "dkimConfigured": {
      "type": "boolean",
      "default": false
    },
    "dmarcConfigured": {
      "type": "boolean",
      "default": false
    },
    "trackingConfigured": {
      "type": "boolean",
      "default": false
    },
    "defaultTimezone": {
      "type": "string",
      "default": "America/Chicago"
    },
    "requireApprovalBeforeSend": {
      "type": "boolean",
      "default": true
    },
    "enableAiGeneration": {
      "type": "boolean",
      "default": true
    },
    "enableAutoSending": {
      "type": "boolean",
      "default": false
    },
    "enableWebhookTracking": {
      "type": "boolean",
      "default": true
    },
    "enableClickTracking": {
      "type": "boolean",
      "default": true
    },
    "enableOpenTracking": {
      "type": "boolean",
      "default": true
    },
    "dailySendLimit": {
      "type": "number",
      "default": 2000
    },
    "hourlySendLimit": {
      "type": "number",
      "default": 500
    },
    "maxRecipientsPerCampaign": {
      "type": "number",
      "default": 5000
    },
    "maxTestSendsPerHour": {
      "type": "number",
      "default": 10
    },
    "pauseAfterBounceCount": {
      "type": "number",
      "default": 50
    },
    "pauseAfterComplaintCount": {
      "type": "number",
      "default": 10
    },
    "requireUnsubscribeLink": {
      "type": "boolean",
      "default": true
    },
    "defaultUnsubscribeFooter": {
      "type": "string"
    },
    "includeCompanyAddress": {
      "type": "boolean",
      "default": true
    },
    "suppressBounced": {
      "type": "boolean",
      "default": true
    },
    "suppressComplained": {
      "type": "boolean",
      "default": true
    },
    "suppressUnsubscribed": {
      "type": "boolean",
      "default": true
    },
    "defaultFooterText": {
      "type": "string"
    },
    "companyName": {
      "type": "string"
    },
    "companyAddress": {
      "type": "string"
    },
    "unsubscribeEnabled": {
      "type": "boolean",
      "default": true
    },
    "suppressionEnabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}