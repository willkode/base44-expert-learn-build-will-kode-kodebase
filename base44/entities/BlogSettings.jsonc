{
  "name": "BlogSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "default": "global",
      "description": "Singleton settings key, use 'global'"
    },
    "blogEnabled": {
      "type": "boolean",
      "default": true
    },
    "enablePublicBlogPages": {
      "type": "boolean",
      "default": true,
      "description": "When off, public blog routes are hidden even if the blog is enabled"
    },
    "blogName": {
      "type": "string",
      "default": "Blog"
    },
    "blogDescription": {
      "type": "string"
    },
    "publicBlogRoute": {
      "type": "string",
      "default": "/learn/blog",
      "description": "Base public route for the blog"
    },
    "defaultAuthorName": {
      "type": "string",
      "default": "KodeBase Team"
    },
    "defaultAuthorBio": {
      "type": "string"
    },
    "defaultAuthorAvatarUrl": {
      "type": "string"
    },
    "defaultAuthorWebsite": {
      "type": "string"
    },
    "defaultAuthorTwitter": {
      "type": "string"
    },
    "defaultAuthorLinkedin": {
      "type": "string"
    },
    "defaultLanguage": {
      "type": "string",
      "default": "en"
    },
    "defaultTimezone": {
      "type": "string",
      "default": "America/Chicago"
    },
    "defaultPostStatus": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "approved",
        "scheduled",
        "published"
      ],
      "default": "draft"
    },
    "requireApprovalBeforePublish": {
      "type": "boolean",
      "default": true
    },
    "enableScheduledPublishing": {
      "type": "boolean",
      "default": true
    },
    "allowManualPublish": {
      "type": "boolean",
      "default": true
    },
    "notifyOnPublish": {
      "type": "boolean",
      "default": false
    },
    "enableAiGeneration": {
      "type": "boolean",
      "default": true
    },
    "enableAiImageGeneration": {
      "type": "boolean",
      "default": true
    },
    "enableAutoPublishing": {
      "type": "boolean",
      "default": false
    },
    "enableSeoScoring": {
      "type": "boolean",
      "default": true
    },
    "enableInternalLinking": {
      "type": "boolean",
      "default": true
    },
    "enableContentRefreshRecommendations": {
      "type": "boolean",
      "default": true
    },
    "enableAnalyticsTracking": {
      "type": "boolean",
      "default": true,
      "description": "Whether first-party blog analytics tracking is active"
    },
    "enableBlogRepurposing": {
      "type": "boolean",
      "default": true,
      "description": "Whether AI repurposing of posts into other formats is allowed"
    },
    "enableKeywordTracking": {
      "type": "boolean",
      "default": true
    },
    "enableSitemapUpdates": {
      "type": "boolean",
      "default": true
    },
    "requireSeoScoreBeforePublish": {
      "type": "boolean",
      "default": false,
      "description": "Block publishing until a minimum SEO score is reached"
    },
    "minSeoScoreToPublish": {
      "type": "number",
      "default": 60,
      "description": "Minimum SEO score required to publish when SEO gate is enabled"
    },
    "requireFeaturedImageBeforePublish": {
      "type": "boolean",
      "default": false
    },
    "requireMetaTitleBeforePublish": {
      "type": "boolean",
      "default": false
    },
    "requireMetaDescriptionBeforePublish": {
      "type": "boolean",
      "default": false
    },
    "requireCategoryBeforePublish": {
      "type": "boolean",
      "default": false
    },
    "blockDuplicateTargetKeywords": {
      "type": "boolean",
      "default": false,
      "description": "Prevent two published posts from targeting the same primary keyword"
    },
    "warnKeywordCannibalization": {
      "type": "boolean",
      "default": true,
      "description": "Warn (non-blocking) when posts may compete for the same keyword"
    },
    "blockPlaceholderText": {
      "type": "boolean",
      "default": true,
      "description": "Block publishing content containing placeholder text like lorem ipsum or TODO"
    },
    "warnUnsupportedClaims": {
      "type": "boolean",
      "default": false,
      "description": "Warn when content contains absolute/unsupported claims"
    },
    "maxAiPostsPerDay": {
      "type": "number",
      "default": 10
    },
    "maxAiImagesPerDay": {
      "type": "number",
      "default": 20
    },
    "maxRefreshFixesPerDay": {
      "type": "number",
      "default": 15
    },
    "maxRepurposingPerDay": {
      "type": "number",
      "default": 10
    },
    "maxContentPlanPostsPerGeneration": {
      "type": "number",
      "default": 20
    },
    "defaultArticleTone": {
      "type": "string",
      "default": "Professional, helpful, and authoritative"
    },
    "defaultArticleLength": {
      "type": "string",
      "enum": [
        "short",
        "medium",
        "long",
        "comprehensive"
      ],
      "default": "long"
    },
    "minWordCount": {
      "type": "number",
      "default": 600
    },
    "maxWordCount": {
      "type": "number",
      "default": 3000
    },
    "requireCta": {
      "type": "boolean",
      "default": false
    },
    "requireFaq": {
      "type": "boolean",
      "default": false
    },
    "requireInternalLinks": {
      "type": "boolean",
      "default": false
    },
    "requireHumanReview": {
      "type": "boolean",
      "default": true
    },
    "defaultContentStructure": {
      "type": "string",
      "description": "Default outline/structure guidance for AI articles"
    },
    "defaultCta": {
      "type": "string",
      "description": "Default call-to-action block for generated posts"
    },
    "defaultBrandVoice": {
      "type": "string",
      "description": "Brand voice guidance for AI generation"
    },
    "bannedWords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Words/phrases AI should avoid"
    },
    "preferredWords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Words/phrases AI should prefer"
    },
    "requiredBrandTerms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Brand terms that should appear in generated content"
    },
    "notifyOnNeedsReview": {
      "type": "boolean",
      "default": true
    },
    "notifyOnApproved": {
      "type": "boolean",
      "default": false
    },
    "notifyOnPublishingFailed": {
      "type": "boolean",
      "default": true
    },
    "notifyOnRefreshRecommended": {
      "type": "boolean",
      "default": false
    },
    "notifyOnLowSeoScore": {
      "type": "boolean",
      "default": false
    },
    "notificationEmail": {
      "type": "string",
      "description": "Email address that receives blog admin notifications"
    },
    "permCreatePosts": {
      "type": "string",
      "enum": [
        "admin",
        "editor",
        "any"
      ],
      "default": "admin"
    },
    "permEditPosts": {
      "type": "string",
      "enum": [
        "admin",
        "editor",
        "any"
      ],
      "default": "admin"
    },
    "permApprovePosts": {
      "type": "string",
      "enum": [
        "admin",
        "editor"
      ],
      "default": "admin"
    },
    "permPublishPosts": {
      "type": "string",
      "enum": [
        "admin",
        "editor"
      ],
      "default": "admin"
    },
    "permManageSettings": {
      "type": "string",
      "enum": [
        "admin"
      ],
      "default": "admin"
    },
    "permViewAnalytics": {
      "type": "string",
      "enum": [
        "admin",
        "editor"
      ],
      "default": "admin"
    },
    "permUseAiGeneration": {
      "type": "string",
      "enum": [
        "admin",
        "editor"
      ],
      "default": "admin"
    },
    "defaultFeaturedImageStyle": {
      "type": "string",
      "default": "Dark tech aesthetic: deep navy background, orange-to-amber gradient accents, minimal flat vector, blueprint grid, soft glows."
    },
    "defaultMetaTitleTemplate": {
      "type": "string",
      "default": "{{title}} | KodeBase"
    },
    "defaultMetaDescriptionTemplate": {
      "type": "string",
      "default": "{{excerpt}}"
    },
    "defaultCanonicalUrlBase": {
      "type": "string"
    },
    "defaultOgImageUrl": {
      "type": "string"
    },
    "defaultTwitterImageUrl": {
      "type": "string"
    },
    "defaultCategoryFallback": {
      "type": "string",
      "default": "General"
    },
    "noindexDraftsAndPreviews": {
      "type": "boolean",
      "default": true
    },
    "postsPerPage": {
      "type": "number",
      "default": 12
    },
    "showAuthorBox": {
      "type": "boolean",
      "default": true
    },
    "showRelatedPosts": {
      "type": "boolean",
      "default": true
    },
    "showTableOfContents": {
      "type": "boolean",
      "default": false
    },
    "allowComments": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}