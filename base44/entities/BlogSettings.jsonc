{
  "name": "BlogSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "default": "global",
      "description": "Singleton settings key, use 'global'"
    },
    "blogEnabled": {
      "type": "boolean",
      "default": true
    },
    "blogName": {
      "type": "string",
      "default": "Blog"
    },
    "blogDescription": {
      "type": "string"
    },
    "publicBlogRoute": {
      "type": "string",
      "default": "/learn/blog",
      "description": "Base public route for the blog"
    },
    "defaultAuthorName": {
      "type": "string",
      "default": "KodeBase Team"
    },
    "defaultAuthorBio": {
      "type": "string"
    },
    "defaultAuthorAvatarUrl": {
      "type": "string"
    },
    "defaultAuthorWebsite": {
      "type": "string"
    },
    "defaultAuthorTwitter": {
      "type": "string"
    },
    "defaultAuthorLinkedin": {
      "type": "string"
    },
    "defaultLanguage": {
      "type": "string",
      "default": "en"
    },
    "defaultTimezone": {
      "type": "string",
      "default": "America/Chicago"
    },
    "defaultPostStatus": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "approved",
        "scheduled",
        "published"
      ],
      "default": "draft"
    },
    "requireApprovalBeforePublish": {
      "type": "boolean",
      "default": true
    },
    "enableScheduledPublishing": {
      "type": "boolean",
      "default": true
    },
    "allowManualPublish": {
      "type": "boolean",
      "default": true
    },
    "notifyOnPublish": {
      "type": "boolean",
      "default": false
    },
    "enableAiGeneration": {
      "type": "boolean",
      "default": true
    },
    "enableAiImageGeneration": {
      "type": "boolean",
      "default": true
    },
    "enableAutoPublishing": {
      "type": "boolean",
      "default": false
    },
    "enableSeoScoring": {
      "type": "boolean",
      "default": true
    },
    "enableInternalLinking": {
      "type": "boolean",
      "default": true
    },
    "enableContentRefreshRecommendations": {
      "type": "boolean",
      "default": true
    },
    "enableKeywordTracking": {
      "type": "boolean",
      "default": true
    },
    "enableSitemapUpdates": {
      "type": "boolean",
      "default": true
    },
    "defaultArticleTone": {
      "type": "string",
      "default": "Professional, helpful, and authoritative"
    },
    "defaultArticleLength": {
      "type": "string",
      "enum": [
        "short",
        "medium",
        "long",
        "comprehensive"
      ],
      "default": "long"
    },
    "defaultContentStructure": {
      "type": "string",
      "description": "Default outline/structure guidance for AI articles"
    },
    "defaultCta": {
      "type": "string",
      "description": "Default call-to-action block for generated posts"
    },
    "defaultBrandVoice": {
      "type": "string",
      "description": "Brand voice guidance for AI generation"
    },
    "bannedWords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Words/phrases AI should avoid"
    },
    "preferredWords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Words/phrases AI should prefer"
    },
    "defaultFeaturedImageStyle": {
      "type": "string",
      "default": "Dark tech aesthetic: deep navy background, orange-to-amber gradient accents, minimal flat vector, blueprint grid, soft glows."
    },
    "defaultMetaTitleTemplate": {
      "type": "string",
      "default": "{{title}} | KodeBase"
    },
    "defaultMetaDescriptionTemplate": {
      "type": "string",
      "default": "{{excerpt}}"
    },
    "defaultCanonicalUrlBase": {
      "type": "string"
    },
    "defaultOgImageUrl": {
      "type": "string"
    },
    "defaultTwitterImageUrl": {
      "type": "string"
    },
    "defaultCategoryFallback": {
      "type": "string",
      "default": "General"
    },
    "noindexDraftsAndPreviews": {
      "type": "boolean",
      "default": true
    },
    "postsPerPage": {
      "type": "number",
      "default": 12
    },
    "showAuthorBox": {
      "type": "boolean",
      "default": true
    },
    "showRelatedPosts": {
      "type": "boolean",
      "default": true
    },
    "showTableOfContents": {
      "type": "boolean",
      "default": false
    },
    "allowComments": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}