{
  "name": "BuildTutorial",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Tutorial title"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Link to the external tutorial (also the dedupe key for imports)"
    },
    "category": {
      "type": "string",
      "default": "Uncategorized",
      "description": "What you build, e.g. Database, Git, Web Server"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Programming languages used, e.g. [\"C++\", \"Python\"]"
    },
    "slug": {
      "type": "string",
      "description": "URL slug for /learn/build-your-own/:slug"
    },
    "description": {
      "type": "string",
      "description": "Short summary shown on cards and at the top of the guide page"
    },
    "difficulty": {
      "type": "string",
      "description": "Beginner, Intermediate or Advanced (empty = not set)"
    },
    "timeEstimate": {
      "type": "string",
      "description": "Rough time to complete, e.g. 3\u20135 hours"
    },
    "sourceName": {
      "type": "string",
      "description": "Original author/site credited at the bottom of the guide page"
    },
    "writeup": {
      "type": "string",
      "description": "Original KodeBase breakdown (markdown) shown on the guide page"
    },
    "writeupGeneratedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the write-up was last AI-generated"
    },
    "isVideo": {
      "type": "boolean",
      "default": false,
      "description": "Tutorial is a video or video series"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Pinned to the top of its category"
    },
    "published": {
      "type": "boolean",
      "default": true,
      "description": "Visible on /learn/build-your-own"
    },
    "source": {
      "type": "string",
      "enum": [
        "build-your-own-x",
        "manual"
      ],
      "default": "manual",
      "description": "Where the entry came from"
    }
  },
  "required": [
    "title",
    "url",
    "category"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "$and": [
        {
          "created_by_id": {
            "$ne": "anonymous"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}