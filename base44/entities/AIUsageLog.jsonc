{
  "name": "AIUsageLog",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Related project ID"
    },
    "agent": {
      "type": "string",
      "description": "Which architect agent ran"
    },
    "action": {
      "type": "string",
      "description": "Action performed"
    },
    "tokens_used": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error"
      ],
      "default": "success"
    }
  },
  "required": [
    "agent"
  ]
}