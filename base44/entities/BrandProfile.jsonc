{
  "name": "BrandProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string",
      "default": "global",
      "description": "Workspace/account scope key"
    },
    "brand_name": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "pain_points": {
      "type": "string",
      "description": "Customer pain points the brand solves"
    },
    "products_services": {
      "type": "string"
    },
    "tone_of_voice": {
      "type": "string"
    },
    "preferred_tone": {
      "type": "string",
      "description": "Preferred tone key (professional, casual, bold, educational, witty, direct, community_focused, sales_driven)"
    },
    "banned_words": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "preferred_words": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "value_propositions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "competitor_notes": {
      "type": "string"
    },
    "default_call_to_action": {
      "type": "string"
    },
    "default_hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "visual_style": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "brand_colors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "facebook_content_style": {
      "type": "string",
      "description": "Guidance for Facebook Page content style"
    },
    "instagram_style": {
      "type": "string",
      "description": "Guidance for Instagram visual and caption style"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}