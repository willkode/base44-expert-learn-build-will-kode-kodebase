{
  "name": "BrandProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string",
      "default": "global",
      "description": "Workspace/account scope key"
    },
    "brand_name": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "products_services": {
      "type": "string"
    },
    "tone_of_voice": {
      "type": "string"
    },
    "banned_words": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "preferred_words": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "value_propositions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "competitor_notes": {
      "type": "string"
    },
    "default_call_to_action": {
      "type": "string"
    },
    "default_hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "visual_style": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "brand_colors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}