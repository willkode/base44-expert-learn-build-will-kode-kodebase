{
  "name": "PromptItem",
  "type": "object",
  "properties": {
    "promptPackId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "promptNumber": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "promptText": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "dependencies": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_used",
        "copied",
        "completed"
      ],
      "default": "not_used"
    }
  },
  "required": [
    "promptPackId"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}