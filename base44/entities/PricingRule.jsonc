{
  "name": "PricingRule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "flat",
        "per_unit",
        "multiplier",
        "manual_review"
      ]
    },
    "base_amount": {
      "type": "number",
      "default": 0
    },
    "per_unit_amount": {
      "type": "number",
      "default": 0
    },
    "included_quantity": {
      "type": "number",
      "default": 0
    },
    "minimum_amount": {
      "type": "number",
      "default": 0
    },
    "maximum_amount": {
      "type": "number"
    },
    "complexity_multiplier": {
      "type": "number",
      "default": 1
    },
    "condition_config": {
      "type": "object",
      "additionalProperties": true
    },
    "manual_review_threshold": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "category",
    "rule_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}