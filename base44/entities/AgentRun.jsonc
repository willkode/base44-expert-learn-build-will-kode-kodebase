{
  "name": "AgentRun",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "agentName": {
      "type": "string"
    },
    "inputSummary": {
      "type": "string"
    },
    "outputSummary": {
      "type": "string"
    },
    "outputData": {
      "type": "string",
      "description": "Serialized JSON output of this agent run, used to resume multi-step generation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "success",
        "failed"
      ],
      "default": "pending"
    },
    "errorMessage": {
      "type": "string"
    }
  },
  "required": [
    "agentName"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}