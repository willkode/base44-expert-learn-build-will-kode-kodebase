{
  "name": "QAChecklist",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the related Project"
    },
    "items": {
      "type": "array",
      "description": "QA checklist items",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "required": [
    "project_id"
  ]
}