{
  "name": "ReportEntitlement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "access_status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "granted_at": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string"
    },
    "granted_by_admin_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "project_id",
    "report_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}