{
  "name": "SocialCampaign",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owning user id"
    },
    "account_id": {
      "type": "string",
      "default": "global",
      "description": "Workspace/account scope key"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "enum": [
        "awareness",
        "traffic",
        "leads",
        "sales",
        "engagement",
        "retention",
        "launch",
        "announcement"
      ],
      "default": "awareness"
    },
    "target_audience": {
      "type": "string"
    },
    "brand_voice": {
      "type": "string"
    },
    "offer_details": {
      "type": "string"
    },
    "landing_page_url": {
      "type": "string"
    },
    "key_message": {
      "type": "string",
      "description": "Core message threaded through every post in the campaign"
    },
    "content_themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Recurring content themes/angles for the campaign"
    },
    "posting_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "few_times_week",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "weekly"
    },
    "default_platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "twitter",
          "reddit",
          "linkedin",
          "facebook",
          "instagram"
        ]
      },
      "default": []
    },
    "default_hashtag_strategy": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "archived"
      ],
      "default": "draft"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "approval_required": {
      "type": "boolean",
      "default": true
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}