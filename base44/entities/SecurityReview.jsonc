{
  "name": "SecurityReview",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the related Project"
    },
    "findings": {
      "type": "array",
      "description": "Security findings",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "score": {
      "type": "number",
      "description": "Overall security score 0-100"
    }
  },
  "required": [
    "project_id"
  ]
}